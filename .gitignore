# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.scratch/

# ops/ is tracked on purpose. It holds this project's plans and PRDs, which the
# vault discovers as a codebase project (pm-authoring rule 5). They are backed up
# by this repo's remote, not by Obsidian Sync — unshared/ never syncs — so
# ignoring them would leave them backed up by nothing at all.
